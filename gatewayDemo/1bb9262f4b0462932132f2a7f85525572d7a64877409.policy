@id("allow_one")
permit(
  principal is gatewayDemo::Workload,
  action == gatewayDemo::Action::"GET",
  resource is gatewayDemo::HTTP_Request
)
when {
  (
  (principal has "access_token") && 
  ((principal["access_token"]) has "scope")) && 
  (((principal["access_token"])["scope"]).contains("profiledd"))
};